{
  "name": "product-photo-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r lint",
    "generate": "pnpm --filter @product-photo/api generate",
    "db:generate": "pnpm --filter @product-photo/api prisma:generate",
    "db:migrate": "pnpm --filter @product-photo/api prisma:migrate"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
