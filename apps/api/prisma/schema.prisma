generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GenerationStatus {
  QUEUED
  ANALYZING
  GENERATING
  DONE
  FAILED
}

enum Role {
  SUPER_ADMIN
  USER
}

model User {
  id                    String           @id @default(cuid())
  email                 String           @unique
  name                  String
  passwordHash          String
  role                  Role             @default(USER)
  isActive              Boolean          @default(true)
  bannedUntil           DateTime?
  banReason             String?
  requestLimitPerHour   Int              @default(10)
  requestLimitPerDay    Int              @default(30)
  maxVariantsPerRequest Int              @default(12)
  maxConcurrentRequests Int              @default(1)
  lastLoginAt           DateTime?
  loginCount            Int              @default(0)
  generations           Generation[]
  campaigns             Campaign[]
  brandProfile          BrandProfile?
  productAnalyses       ProductAnalysis[]
  notifications         Notification[]
  supportTickets        SupportTicket[]
  sessions              RefreshSession[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([role])
  @@map("users")
}

model BrandProfile {
  id                        String                @id @default(cuid())
  userId                    String                @unique
  user                      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandName                 String
  businessType              String                @default("other")
  businessSubcategory       String?
  website                   String?
  description               String?
  slogan                    String?
  markets                   String[]              @default([])
  languages                 String[]              @default(["en"])
  audience                  Json                  @default("{}")
  positioning               String?
  values                    String[]              @default([])
  tone                      String[]              @default([])
  primaryColor              String                @default("#111111")
  secondaryColors           String[]              @default([])
  accentColors              String[]              @default([])
  primaryFont               String?
  secondaryFont             String?
  photographyStyles         String[]              @default([])
  preferredEnvironments     String[]              @default([])
  forbiddenEnvironments     String[]              @default([])
  preferredModelAttributes  Json                  @default("{}")
  defaultChannels           String[]              @default([])
  defaultAspectRatios       String[]              @default([])
  defaultCampaignObjectives String[]              @default([])
  forbiddenVisualElements   String[]              @default([])
  requiredVisualElements    String[]              @default([])
  logoKey                   String?
  logoOriginalName          String?
  logoMimeType              String?
  onboardingComplete        Boolean               @default(false)
  version                   Int                   @default(1)
  versions                  BrandProfileVersion[]
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt

  @@index([businessType])
  @@map("brand_profiles")
}

model BrandProfileVersion {
  id             String       @id @default(cuid())
  brandProfileId String
  brandProfile   BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  version        Int
  snapshot       Json
  createdAt      DateTime     @default(now())

  @@unique([brandProfileId, version])
  @@index([brandProfileId, createdAt])
  @@map("brand_profile_versions")
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  title       String
  body        String
  channel     String    @default("in_app")
  emailSentAt DateTime?
  emailError  String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

model SupportTicket {
  id            String           @id @default(cuid())
  userId        String
  subject       String
  status        String           @default("open")
  lastMessageAt DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      SupportMessage[]

  @@index([status, lastMessageAt])
  @@index([userId, lastMessageAt])
  @@map("support_tickets")
}

model SupportMessage {
  id         String        @id @default(cuid())
  ticketId   String
  authorId   String?
  authorName String
  fromAdmin  Boolean       @default(false)
  body       String
  createdAt  DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

model WaitlistMessage {
  id           String   @id @default(cuid())
  subscriberId String
  channel      String   @default("whatsapp")
  template     String
  body         String
  sentByName   String?
  createdAt    DateTime @default(now())

  @@index([subscriberId, createdAt])
  @@map("waitlist_messages")
}

model ProductAnalysis {
  id           String   @id
  userId       String
  inputKey     String
  category     String
  productType  String
  productClass String
  summary      String
  confidence   Decimal  @default(0) @db.Decimal(4, 3)
  attributes   Json
  scenes       Json
  model        String
  costUsd      Decimal  @default(0) @db.Decimal(12, 6)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])

  @@map("product_analyses")
}

model PlatformSetting {
  id                  String   @id @default("main")
  generationProvider  String   @default("cloudflare")
  providerCredentials Json?
  credentialMetadata  Json?
  providerModels      Json?
  updatedAt           DateTime @updatedAt

  @@map("platform_settings")
}

model RefreshSession {
  id        String    @id
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model Campaign {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  productType     String?
  category        String
  sceneId         String
  brief           String?
  creativeOptions Json?
  generations     Generation[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId, updatedAt])
  @@map("campaigns")
}

model Generation {
  id                  String           @id @default(cuid())
  userId              String?
  user                User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  campaignId          String?
  campaign            Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  sharedAt            DateTime?
  ownerName           String?
  ownerEmail          String?
  status              GenerationStatus @default(QUEUED)
  provider            String           @default("openai")
  model               String           @default("gpt-image-2")
  quality             String           @default("medium")
  imageSize           String           @default("1024x1024")
  category            String
  sceneId             String
  brief               String?
  creativeOptions     Json?
  productType         String?
  brandProfileVersion Int?
  brandSnapshot       Json?
  productContext      Json?
  creativePlan        Json?
  creativeFingerprint String?
  contextWarnings     String[]         @default([])
  inputKey            String
  outputKeys          String[]         @default([])
  keptOutputKeys      String[]         @default([])
  requestedVariants   Int              @default(1)
  inputTokens         Int              @default(0)
  inputTextTokens     Int              @default(0)
  inputImageTokens    Int              @default(0)
  outputTokens        Int              @default(0)
  totalTokens         Int              @default(0)
  providerUsageUnits  Decimal          @default(0) @db.Decimal(12, 2)
  providerUsageUnit   String           @default("tokens")
  costUsd             Decimal          @default(0) @db.Decimal(10, 6)
  durationMs          Int              @default(0)
  error               String?
  errorCode           String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([createdAt])
  @@index([status])
  @@index([userId])
  @@index([provider, createdAt])
  @@index([creativeFingerprint])
  @@index([campaignId])
  @@index([sharedAt])
  @@map("generation_runs")
}

model SiteVisit {
  id        String   @id @default(cuid())
  path      String
  visitorId String
  referrer  String?
  country   String?
  device    String   @default("desktop")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([visitorId, createdAt])
  @@index([path, createdAt])
  @@map("site_visits")
}

model WaitlistSubscriber {
  id          String    @id @default(cuid())
  email       String?   @unique
  phone       String?   @unique
  locale      String    @default("en")
  source      String    @default("landing")
  offerCode   String    @default("launch_free_week")
  status      String    @default("new")
  notes       String?
  contactedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([createdAt])
  @@index([status, createdAt])
  @@map("waitlist_subscribers")
}
