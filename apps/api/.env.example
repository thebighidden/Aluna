DATABASE_URL=postgresql://product_photo:product_photo@localhost:5432/product_photo?schema=public
REDIS_URL=redis://localhost:6379
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:4173,http://127.0.0.1:4173

# Image provider: cloudflare (default), openai, or auto.
GENERATION_PROVIDER=cloudflare

# Cloudflare Workers AI / FLUX.2 Klein 9B. The R2 account ID is reused when this ID is blank.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/black-forest-labs/flux-2-klein-9b
CLOUDFLARE_AI_WIDTH=1024
CLOUDFLARE_AI_HEIGHT=1024
# Internal safety guard aligned with the Workers AI free daily allocation. Use 0 to disable.
CLOUDFLARE_AI_DAILY_NEURON_BUDGET=10000

# Optional OpenAI provider. Set GENERATION_PROVIDER=openai to use it.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_OUTPUT_COST_USD=0.053
# Optional organization admin key for exact OpenAI Usage/Costs reconciliation in the dashboard.
OPENAI_ADMIN_KEY=

# Replace these values for production deployments.
JWT_ACCESS_SECRET=aluna-development-access-secret-change-me-2026
JWT_REFRESH_SECRET=aluna-development-refresh-secret-change-me-2026
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
DEMO_USER_EMAIL=demo@aluna.studio
DEMO_USER_PASSWORD=AlunaDemo2026!
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Aluna Administrator

# Optional Cloudflare R2. If any are omitted, files are stored under ./output.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
