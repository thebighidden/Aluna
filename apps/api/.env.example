GEMINI_API_KEY=
DATABASE_URL=postgresql://product_photo:product_photo@localhost:5432/product_photo?schema=public
REDIS_URL=redis://localhost:6379
PORT=3001

# Cost-estimation defaults for gemini-2.5-flash-image; update when Google pricing changes.
GEMINI_IMAGE_OUTPUT_COST_USD=0.039
GEMINI_INPUT_COST_PER_MILLION_TOKENS_USD=0.30

# Optional Cloudflare R2. If any are omitted, files are stored under ./output.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
