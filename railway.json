{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @product-photo/api prisma:generate && pnpm --filter @product-photo/api build",
    "watchPatterns": [
      "/apps/api/**",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/railway.json"
    ]
  },
  "deploy": {
    "preDeployCommand": "pnpm --filter @product-photo/api prisma:deploy",
    "startCommand": "pnpm --filter @product-photo/api start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
